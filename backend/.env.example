# Local/manual reference only. On the deploy server, `.env` is written
# automatically by the CI deploy job (`.github/workflows/ci.yml`) from the
# `INGEST_TOKEN` repository secret on every deploy - don't hand-maintain it
# there. docker-compose.yml reads this file automatically; CI's source
# sync step to the server excludes .env either way.

INGEST_TOKEN=CHANGE_ME_SHARED_BEARER_TOKEN_FOR_POST_READINGS
