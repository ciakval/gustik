# Real backend environment on the deploy server (DEPLOY_PATH). Copy this to
# `.env` there (never committed - see .gitignore) and fill in real values.
# docker-compose.yml reads this file automatically; CI's rsync deploy step
# excludes .env so it survives every redeploy.

INGEST_TOKEN=CHANGE_ME_SHARED_BEARER_TOKEN_FOR_POST_READINGS
